{
  "manifest_version": 3,
  "name": "Bionic Reading",
  "description": "Read faster. Bolds the start of each word to guide your eyes — adjustable intensity, optional highlight, per-site memory. 100% private.",
  "version": "2.1",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-bionic-reading": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle Bionic Reading"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/inactive-icon-16.png",
      "32": "icons/inactive-icon-32.png",
      "48": "icons/inactive-icon-48.png",
      "128": "icons/inactive-icon-128.png"
    }
  },
  "icons": {
    "16": "icons/inactive-icon-16.png",
    "32": "icons/inactive-icon-32.png",
    "48": "icons/inactive-icon-48.png",
    "128": "icons/inactive-icon-128.png"
  }
}
